# ----------------------------------------------------------------------------
# TBTM — Variables d'environnement
# Copier ce fichier en `.env.local` et remplir avec tes valeurs.
# ----------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------
# Format Postgres : postgresql://USER:PASS@HOST:PORT/DBNAME?schema=public
# Pour Supabase : récupère "Connection string" → URI dans Settings > Database.
# Utilise le port 6543 (pooler) pour les queries app, port 5432 pour les
# migrations Prisma (variable DIRECT_URL ci-dessous).
DATABASE_URL="postgresql://postgres:password@localhost:5432/tbtm?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/tbtm?schema=public"

# --- NextAuth --------------------------------------------------------------
# Génère un secret avec : openssl rand -base64 32
NEXTAUTH_SECRET=""
# URL publique de l'app. En dev : http://localhost:3000 — en prod, ton domaine.
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Google OAuth (optionnel) ---------------------------------------------
# https://console.cloud.google.com/apis/credentials
# Redirect URI à autoriser : ${NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Spotify (optionnel, mini-player en mode séance live) -----------------
# 1. Va sur https://developer.spotify.com/dashboard
# 2. Login + "Create app"
# 3. Nom (TBTM Dev), description (peu importe), site web (peu importe)
# 4. "Redirect URI" : AJOUTER EXACTEMENT  ${NEXT_PUBLIC_APP_URL}/api/spotify/callback
#    Pour dev local HTTPS :  https://localhost:3000/api/spotify/callback
#    Pour dev téléphone :    https://192.168.1.96:3000/api/spotify/callback
#    (Tu peux en mettre plusieurs, sépare par des espaces dans le form Spotify)
# 5. API used : "Web API"
# 6. Save → "Settings" de l'app → copie Client ID + Client Secret ici-dessous
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# --- OpenFoodFacts ---------------------------------------------------------
# Pas de clé requise — c'est public. Variable disponible si tu veux passer
# par un proxy interne plus tard.
NEXT_PUBLIC_OFF_BASE_URL="https://world.openfoodfacts.org"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
